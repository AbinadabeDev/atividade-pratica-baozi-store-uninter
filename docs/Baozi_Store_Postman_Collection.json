{
  "info": {
    "name": "Baozi Store API - Atividade Pratica",
    "description": "Coleção Postman para testar a API REST Baozi Store. Antes da entrega, substitua o nome do cliente pelo seu nome seguido do RU real.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "clienteNome", "value": "AbinadabeOliveira0000000" },
    { "key": "clienteId", "value": "1" },
    { "key": "produtoId", "value": "1" },
    { "key": "pedidoId", "value": "1" }
  ],
  "item": [
    {
      "name": "01 - Criar Cliente",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"{{clienteNome}}\",\n  \"clienteDesde\": \"2026-05-12\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/clientes", "host": ["{{baseUrl}}"], "path": ["clientes"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
          "const json = pm.response.json();",
          "pm.collectionVariables.set('clienteId', json.id);"
        ]}
      }]
    },
    {
      "name": "02 - Criar Produto",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Baozi de Carne Suína\",\n  \"preco\": 12.90,\n  \"estoque\": true\n}"
        },
        "url": { "raw": "{{baseUrl}}/produtos", "host": ["{{baseUrl}}"], "path": ["produtos"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
          "const json = pm.response.json();",
          "pm.collectionVariables.set('produtoId', json.id);"
        ]}
      }]
    },
    {
      "name": "03 - Criar Pedido",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"produtoId\": {{produtoId}},\n  \"quantidade\": 3\n}"
        },
        "url": { "raw": "{{baseUrl}}/pedidos", "host": ["{{baseUrl}}"], "path": ["pedidos"] }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
          "const json = pm.response.json();",
          "pm.collectionVariables.set('pedidoId', json.id);"
        ]}
      }]
    },
    {
      "name": "04 - Listar Clientes",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/clientes", "host": ["{{baseUrl}}"], "path": ["clientes"] } }
    },
    {
      "name": "05 - Listar Produtos",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/produtos", "host": ["{{baseUrl}}"], "path": ["produtos"] } }
    },
    {
      "name": "06 - Listar Pedidos",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/pedidos", "host": ["{{baseUrl}}"], "path": ["pedidos"] } }
    },
    {
      "name": "07 - Consultar Cliente por ID",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/clientes/{{clienteId}}", "host": ["{{baseUrl}}"], "path": ["clientes", "{{clienteId}}"] } }
    },
    {
      "name": "08 - Consultar Produto por ID",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/produtos/{{produtoId}}", "host": ["{{baseUrl}}"], "path": ["produtos", "{{produtoId}}"] } }
    },
    {
      "name": "09 - Consultar Pedido por ID",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/pedidos/{{pedidoId}}", "host": ["{{baseUrl}}"], "path": ["pedidos", "{{pedidoId}}"] } }
    },
    {
      "name": "10 - Atualizar Cliente",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"{{clienteNome}}\",\n  \"clienteDesde\": \"2026-05-12\"\n}" },
        "url": { "raw": "{{baseUrl}}/clientes/{{clienteId}}", "host": ["{{baseUrl}}"], "path": ["clientes", "{{clienteId}}"] }
      }
    },
    {
      "name": "11 - Atualizar Produto",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Baozi de Carne Suína\",\n  \"preco\": 12.90,\n  \"estoque\": true\n}" },
        "url": { "raw": "{{baseUrl}}/produtos/{{produtoId}}", "host": ["{{baseUrl}}"], "path": ["produtos", "{{produtoId}}"] }
      }
    },
    {
      "name": "12 - Atualizar Pedido",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"produtoId\": {{produtoId}},\n  \"quantidade\": 3\n}" },
        "url": { "raw": "{{baseUrl}}/pedidos/{{pedidoId}}", "host": ["{{baseUrl}}"], "path": ["pedidos", "{{pedidoId}}"] }
      }
    },
    {
      "name": "13 - Deletar Pedido",
      "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/pedidos/{{pedidoId}}", "host": ["{{baseUrl}}"], "path": ["pedidos", "{{pedidoId}}"] } }
    },
    {
      "name": "14 - Deletar Produto",
      "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/produtos/{{produtoId}}", "host": ["{{baseUrl}}"], "path": ["produtos", "{{produtoId}}"] } }
    },
    {
      "name": "15 - Deletar Cliente",
      "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/clientes/{{clienteId}}", "host": ["{{baseUrl}}"], "path": ["clientes", "{{clienteId}}"] } }
    }
  ]
}
